{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platizio-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "platizio-site"],
      "port": 3001
    },
    {
      "name": "static-root",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "8080", "."],
      "port": 8080
    },
    {
      "name": "eloqwnt-replica",
      "runtimeExecutable": "node",
      "runtimeArgs": ["eloqwnt-site/_server.mjs"],
      "port": 4789
    }
  ]
}
